{
  "name": "cloud-access-shield-backend",
  "version": "1.0.0",
  "description": "Graph DB-powered IAM & privilege escalation analyzer — backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node -r tsconfig-paths/register src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/src/index.js",
    "seed": "ts-node -r tsconfig-paths/register src/seed.ts",
    "test-queries": "ts-node -r tsconfig-paths/register scripts/test-queries.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "neo4j-driver": "^5.13.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.14",
    "@types/express": "^4.17.20",
    "@types/node": "^20.5.9",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.4.5"
  }
}
